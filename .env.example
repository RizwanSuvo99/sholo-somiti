# ── Database ────────────────────────────────────────────────────────────────
# Local dev runs Postgres from docker-compose.yml on host port 5434
# (5432 is taken by an unrelated container on this machine).
DATABASE_URL="postgresql://somiti:somiti_dev_password@localhost:5434/somiti?schema=public"
# Used by `prisma migrate` when DATABASE_URL points at a pooler. Same value otherwise.
DIRECT_DATABASE_URL="postgresql://somiti:somiti_dev_password@localhost:5434/somiti?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=""

# ── Admin seed (used once by `pnpm db:seed`) ────────────────────────────────
ADMIN_EMAIL=""
ADMIN_NAME=""
# Minimum 12 characters; the seed refuses anything shorter.
ADMIN_PASSWORD=""

# ── Cloudinary ──────────────────────────────────────────────────────────────
# CLOUDINARY_API_SECRET is server-only and must never reach the browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ── Cron ────────────────────────────────────────────────────────────────────
# Bearer token the month-rollover endpoint requires. openssl rand -hex 32
CRON_SECRET=""

# ── Misc ────────────────────────────────────────────────────────────────────
# Keep the process on UTC; Dhaka-local reasoning lives in src/lib/due-cycle.ts.
TZ="UTC"
